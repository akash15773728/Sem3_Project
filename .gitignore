# ============================================================================
# SEHAT-SETU: .gitignore
# Only code and necessary deployment assets are tracked
# ============================================================================

# Environment and sensitive keys
.env
.env.local
.env.*.local
backend/

# Databases & local storage
*.db
*.sqlite
*.sqlite3
backend/app/storage_data/*
!backend/app/storage_data/.gitkeep

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/

# Node & Frontend artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Documentation reports, PDFs, Word docs, and generated evaluation artifacts
*.docx
*.pdf
*REPORT*
*report*
*CHECKLIST*
*checklist*
*TESTING_LOG*
*PROJECT_STATE*
SEHAT_SETU_RDBMS_Design.docx
SEHAT_SETU_RDBMS_ER_Diagram.png
scripts/generate_*.py
azure/
startup.sh
.env.example
DEPLOYMENT_AZURE.md
*.sql

# OS generated files
.DS_Store
Thumbs.db
